# =============================================
# Time alvo
# TARGET_TEAM:        nome usado para casar com o HTML do site (accent/case insensitive)
# TARGET_TEAM_DISPLAY: nome amigável exibido nas imagens geradas
# Times disponíveis no scrape:
# - A.D. BATEBOLA
# - A.D. INDAIATUBA
# - ASSOCIAÇÃO DESPORTIVA DO ABCD - MESC SÃO BERNARDO
# - ASSOCIAÇÃO DESPORTIVA OLIMPIK | ATIVO
# - ASSOCIAÇÃO ESPORTIVA CENTRO DE TREINAMENTO BOLA NO PÉ
# - ASSOCIAÇÃO PORTUGUESA DE DESPORTOS
# - ASSOCIAÇÃO SOROCABANA DE FUTSAL - ASF/MAGNU
# - C.A. JUVENTUS
# - C.A. TABUCA JRS
# - CAMISA 10 F.C. A
# - CLUBE ATLÉTICO YPIRANGA | C.A. YPIRANGA
# - FAE/OSASCO/AUDAX
# - LAUSANNE PAULISTA FC - A
# - LIGA SANCAETANENSE DE F.S.
# - OLE BRASIL SOCIETY QUADRA ESPORTIVA LTDA ME - OLE BRASIL SOCIETY
# - PROSPERE / HORTOLANDIA
# - PULO FUTSAL CAMPINAS
# - S.C. CORINTHIANS PAULISTA PTA.
# - SANTOS FC
# - SE PALMEIRAS
# - SÃO CAETANO FC - RSFC
# - SÃO PAULO FC - A
# - TAUBATÉ UMBRO FUTSAL
# - UNIÃO RD
# =============================================
TARGET_TEAM=ASSOCIAÇÃO SOROCABANA DE FUTSAL
TARGET_TEAM_DISPLAY=A.S.F. MAGNUS

# =============================================
# Comportamento
# =============================================
# Se true, em caso de falha do scrape e havendo cache da categoria de até 24h, usa o cache com aviso
ALLOW_STALE_CACHE=false
DEBUG=false

# =============================================
# Timeouts (ms)
# =============================================
HTTP_TIMEOUT_MS=15000

# =============================================
# Telegram (opcional) — envia as imagens geradas para um canal
# Crie o bot no @BotFather e adicione-o como ADMIN do canal.
# TELEGRAM_CHAT_ID: @nomedocanal (público) ou -100xxxxxxxxxx (numérico).
# Sem estas duas variáveis, o envio é pulado (com aviso).
# =============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
